#!/usr/bin/env python3
"""Launcher do sddm-forge (funciona rodando do repo ou instalado)."""

import os
import sys
from pathlib import Path

_here = Path(__file__).resolve()

# Candidatos onde o pacote `sddmforge` pode estar:
#  - repo:      <repo>/bin/sddm-forge      -> <repo>
#  - instalado: ~/.local/bin/sddm-forge    -> ~/.local/share/sddm-forge
_candidates = [
    _here.parent.parent,
    Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "sddm-forge",
    Path("/usr/share/sddm-forge"),
]

for _root in _candidates:
    if (_root / "sddmforge" / "app.py").is_file():
        sys.path.insert(0, str(_root))
        break

from sddmforge.app import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
